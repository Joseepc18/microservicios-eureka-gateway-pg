# Copiar este archivo a .env y reemplazar los valores. El archivo .env NO se versiona.

# --- PostgreSQL ---
POSTGRES_USER=admin
POSTGRES_PASSWORD=cambiar_esta_clave
POSTGRES_DB=laboratorio
REPLICATION_PASSWORD=cambiar_esta_clave_de_replicacion

# --- Credenciales de cada servicio de negocio ---
# La base y el rol son fijos (los crea database/primary-init.sh): productos_db / productos_app
# y pedidos_db / pedidos_app. Aquí solo se define la clave de cada rol.
PRODUCTOS_DB_PASSWORD=cambiar_clave_productos
PEDIDOS_DB_PASSWORD=cambiar_clave_pedidos

# --- Puertos publicados en el host (el puerto interno de cada contenedor no cambia) ---
EUREKA_PORT=8761
GATEWAY_PORT=8080
PRODUCTOS_1_PORT=8081
PRODUCTOS_2_PORT=8082
PEDIDOS_PORT=8083

# --- Identificador de cada instancia en Eureka (aparece en el instanceId del registro) ---
GATEWAY_INSTANCE_ID=gateway-1
PRODUCTOS_1_INSTANCE_ID=productos-1
PRODUCTOS_2_INSTANCE_ID=productos-2
PEDIDOS_INSTANCE_ID=pedidos-1
