* text=auto
# Los scripts se ejecutan dentro de contenedores Linux: deben conservar fin de línea LF.
*.sh text eol=lf
# Maven Wrapper: el script POSIX debe ser LF (se ejecuta en contenedores Linux); el .cmd, CRLF.
mvnw text eol=lf
*.cmd text eol=crlf
.mvn/wrapper/maven-wrapper.properties text eol=lf
